# Makefile.nanvix - CPython cross-compilation for Nanvix
#
# Copyright(c) The Maintainers of Nanvix.
# Licensed under the MIT License.
#
# Usage:
#   make -f Makefile.nanvix CONFIG_NANVIX=y NANVIX_HOME=/path/to/nanvix all
#
# This Makefile provides Nanvix cross-compilation support similar to QuickJS, zlib,
# SQLite, and OpenSSL. It wraps the standard ./configure build system with Nanvix
# cross-compilation settings.
#
# Dependencies:
#   - zlib (libz.a in NANVIX_HOME/lib)
#   - SQLite (libsqlite3.a in NANVIX_HOME/lib)
#   - OpenSSL (libssl.a, libcrypto.a in NANVIX_HOME/lib)
#   - bzip2 (libbz2.a in NANVIX_HOME/lib)
#   - libffi (libffi.a in NANVIX_HOME/lib)
#
# Structure:
#   .nanvix/mk/common.mk             - variables, toolchain, configure, build, install, clean
#   .nanvix/mk/ramfs.mk              - shared ramfs staging (trim + image build)
#   .nanvix/mk/test-common.mk        - test infrastructure (staging, validation helpers)
#   .nanvix/mk/test-standalone.mk    - standalone deployment mode tests
#   .nanvix/mk/test-multi-process.mk - multi-process deployment mode tests
#   .nanvix/mk/test-single-process.mk - single-process deployment mode tests
#   .nanvix/mk/test-hyperlight.mk    - hyperlight machine type overrides
#   .nanvix/mk/test-microvm.mk       - microvm machine type overrides
#   .nanvix/mk/package-common.mk     - release packaging
#   .nanvix/mk/verify-package.mk     - tarball verification

# ---- Common: variables, toolchain, configure, build, install, clean ----
include .nanvix/mk/common.mk

# Default target
all: build

# ---- Machine-type overrides ----
ifeq ($(PLATFORM),microvm)
  include .nanvix/mk/test-microvm.mk
else
  include .nanvix/mk/test-hyperlight.mk
endif

# ---- Deployment-mode-specific test rules ----
ifeq ($(PROCESS_MODE),standalone)
  include .nanvix/mk/test-standalone.mk
else ifeq ($(PROCESS_MODE),single-process)
  include .nanvix/mk/test-single-process.mk
else
  include .nanvix/mk/test-multi-process.mk
endif

# ---- Packaging ----
include .nanvix/mk/ramfs.mk
include .nanvix/mk/package-common.mk
include .nanvix/mk/verify-package.mk

# test-external-libs: run CPython test modules that exercise sysroot-linked C
# extension modules (zlib, bzip2, OpenSSL, SQLite).  test_ssl is run as a
# second, separate invocation with '-u network' so that loopback SSL tests are
# enabled while keeping the main batch hermetic.
#
# Skipped in standalone mode (ramfs memory limit) and when NANVIX_RELEASE=yes.
# Known per-module skips are documented in NANVIX_SKIP_LIST.md (issue #329).
test-external-libs: test-stage
ifeq ($(PROCESS_MODE),standalone)
	@echo "Test: external library tests skipped for standalone mode (ramfs memory limit)"
else
ifneq ($(NANVIX_RELEASE),yes)
	@echo "Test: external library tests ($(words $(NANVIX_TEST_LIST_EXTERNAL)) modules)..."
	cd $(TEST_STAGING)/sysroot && \
		{ \
			: > /tmp/cpython_exttest.log; \
			timeout 900 ./bin/nanvixd.elf $(NANVIXD_EXTRA_ARGS) -- ./bin/python3.12 -m test \
			  --timeout=120 $(NANVIX_TEST_LIST_EXTERNAL) \
			  < /dev/null > /tmp/cpython_exttest.log 2>&1; \
			exttest_status=$$?; \
			if [ $$exttest_status -ne 0 ]; then \
				echo "  FAIL: external library tests exited with status $$exttest_status"; cat /tmp/cpython_exttest.log; exit 1; \
			fi; \
			echo "  PASS: external library tests completed"; \
		}
	@echo "Test: SSL tests (network resources enabled)..."
	cd $(TEST_STAGING)/sysroot && \
		{ \
			: > /tmp/cpython_ssltest.log; \
			timeout 300 ./bin/nanvixd.elf $(NANVIXD_EXTRA_ARGS) -- ./bin/python3.12 -m test \
			  -u network --timeout=120 test_ssl \
			  < /dev/null > /tmp/cpython_ssltest.log 2>&1; \
			ssltest_status=$$?; \
			if [ $$ssltest_status -ne 0 ]; then \
				echo "  FAIL: SSL tests exited with status $$ssltest_status"; cat /tmp/cpython_ssltest.log; exit 1; \
			fi; \
			echo "  PASS: SSL tests completed"; \
		}
else
	@echo "Test: external library tests skipped (NANVIX_RELEASE=yes)"
endif
endif
	@rm -rf $(TEST_STAGING) /tmp/cpython_exttest.log /tmp/cpython_ssltest.log
	@echo "		*** CPython external library tests PASSED ***"

.PHONY: all test-external-libs
