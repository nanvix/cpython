# Makefile.nanvix - CPython cross-compilation for Nanvix
#
# Copyright(c) The Maintainers of Nanvix.
# Licensed under the MIT License.
#
# The Nanvix SDK supplies the compiler, target C runtime, startup objects, and
# linker script. Third-party dependencies are supplied separately by
# nanvix-zutil in NANVIX_BUILDROOT.

PLATFORM ?= microvm
PROCESS_MODE ?= standalone
MEMORY_SIZE ?= 256mb
INSTALL_PREFIX ?= /
NANVIX_RELEASE ?= no

NANVIX_SDK_ROOT ?= /opt/nanvix
NANVIX_BUILDROOT ?= /mnt/buildroot
NANVIX_TARGET_TRIPLE ?= i686-unknown-nanvix
NANVIX_MANIFEST ?= .nanvix/nanvix.toml
NANVIX_SDK_VERSION = $(shell sed -n 's/^sdk-version = "\(.*\)"/\1/p' $(NANVIX_MANIFEST))
BUILD_PYTHON ?= /usr/bin/python3

SDK_BIN := $(NANVIX_SDK_ROOT)/bin
SDK_MANIFEST := $(NANVIX_SDK_ROOT)/nanvix-sdk.json
EXE := .elf

ifneq ($(MAKECMDGOALS),clean)
  ifndef CONFIG_NANVIX
    $(error CONFIG_NANVIX must be set to 'y')
  endif
  ifeq ($(wildcard $(SDK_MANIFEST)),)
    $(error Nanvix SDK manifest not found at $(SDK_MANIFEST); run this build in the pinned SDK image)
  endif
  ifeq ($(wildcard $(NANVIX_BUILDROOT)/lib),)
    $(error Nanvix dependency buildroot not found at $(NANVIX_BUILDROOT); run './z setup' first)
  endif
endif

TARGET_CC := $(SDK_BIN)/clang --target=$(NANVIX_TARGET_TRIPLE)
TARGET_CXX := $(SDK_BIN)/clang++ --target=$(NANVIX_TARGET_TRIPLE)
TARGET_AR := $(SDK_BIN)/llvm-ar
TARGET_RANLIB := $(SDK_BIN)/llvm-ranlib
TARGET_STRIP := $(SDK_BIN)/llvm-strip

DEPENDENCY_CPPFLAGS := -I$(NANVIX_BUILDROOT)/include
DEPENDENCY_LDFLAGS := -L$(NANVIX_BUILDROOT)/lib
DEPENDENCY_LIBS := \
	-Wl,--start-group \
	-lsqlite3 -lssl -lcrypto -lz -lbz2 -llzma -lffi \
	-Wl,--end-group

CONFIGURE_ENV = \
	CC="$(TARGET_CC)" \
	CXX="$(TARGET_CXX)" \
	LD="$(TARGET_CC)" \
	AR="$(TARGET_AR)" \
	RANLIB="$(TARGET_RANLIB)" \
	STRIP="$(TARGET_STRIP)" \
	CPPFLAGS="$(DEPENDENCY_CPPFLAGS)" \
	CFLAGS="-O3 -fomit-frame-pointer -fno-unwind-tables -fno-asynchronous-unwind-tables" \
	CFLAGS_NODIST="-fno-semantic-interposition" \
	LDFLAGS="$(DEPENDENCY_LDFLAGS) -static -Wl,--export-dynamic" \
	LIBS="$(DEPENDENCY_LIBS)" \
	LIBSQLITE3_LIBS="$(DEPENDENCY_LDFLAGS) -lsqlite3" \
	LIBSQLITE3_CFLAGS="$(DEPENDENCY_CPPFLAGS)" \
	ZLIB_LIBS="$(DEPENDENCY_LDFLAGS) -lz" \
	ZLIB_CFLAGS="$(DEPENDENCY_CPPFLAGS)" \
	BZIP2_LIBS="$(DEPENDENCY_LDFLAGS) -lbz2" \
	BZIP2_CFLAGS="$(DEPENDENCY_CPPFLAGS)" \
	LIBLZMA_LIBS="$(DEPENDENCY_LDFLAGS) -llzma" \
	LIBLZMA_CFLAGS="$(DEPENDENCY_CPPFLAGS)" \
	LIBFFI_LIBS="$(DEPENDENCY_LDFLAGS) -lffi" \
	LIBFFI_CFLAGS="$(DEPENDENCY_CPPFLAGS)"

CONFIGURE_OPTS = \
	--disable-shared \
	--build=x86_64-pc-linux-gnu \
	--host=i686-nanvix \
	--with-build-python="$(BUILD_PYTHON)" \
	$(if $(filter yes,$(NANVIX_RELEASE)),--disable-test-modules,) \
	--prefix="$(INSTALL_PREFIX)" \
	--exec-prefix="$(INSTALL_PREFIX)" \
	--with-ensurepip=no \
	--with-pkg-config=no \
	--with-openssl="$(NANVIX_BUILDROOT)" \
	--disable-ipv6 \
	$(if $(filter yes,$(NANVIX_RELEASE)),--without-doc-strings,) \
	--with-computed-gotos \
	ac_cv_file__dev_ptmx=no \
	ac_cv_file__dev_ptc=no \
	ac_cv_pthread_is_default=yes \
	ac_cv_pthread=yes \
	ac_cv_kthread=no \
	ac_cv_func_dlopen=yes \
	ac_cv_header_dlfcn_h=yes \
	ac_cv_header_sys_socket_h=yes \
	ac_cv_header_netinet_in_h=yes \
	ac_cv_header_arpa_inet_h=yes \
	ac_cv_header_netdb_h=yes \
	ac_cv_func_socket=yes \
	ac_cv_func_bind=yes \
	ac_cv_func_listen=yes \
	ac_cv_func_accept=yes \
	ac_cv_func_connect=yes \
	ac_cv_func_sendto=yes \
	ac_cv_func_recvfrom=yes \
	ac_cv_func_setsockopt=yes \
	ac_cv_func_getpeername=yes \
	ac_cv_func_getsockname=yes \
	ac_cv_func_inet_aton=no \
	ac_cv_func_inet_ntoa=yes \
	ac_cv_func_inet_pton=yes \
	ac_cv_func_statvfs=no \
	ac_cv_func_fstatvfs=no \
	ac_cv_func_fdopendir=no

CONFIGURED_MARKER := .nanvix-configured

all: build

configure: $(CONFIGURED_MARKER)

$(CONFIGURED_MARKER):
	@grep -Eq '"sdk_version"[[:space:]]*:[[:space:]]*"$(NANVIX_SDK_VERSION)"' $(SDK_MANIFEST) || { \
		echo "SDK version mismatch in $(SDK_MANIFEST)"; exit 1; \
	}
	@grep -Eq '"c_abi"[[:space:]]*:[[:space:]]*"i686-nanvix-sysv-1"' $(SDK_MANIFEST) || { \
		echo "SDK C ABI mismatch in $(SDK_MANIFEST)"; exit 1; \
	}
	$(CONFIGURE_ENV) ./configure $(CONFIGURE_OPTS)
	touch $@

build: $(CONFIGURED_MARKER)
	$(MAKE) -j$$(nproc) all
	@if [ -f python ]; then cp -f python python$(EXE); fi
	@test -f python$(EXE)
	$(TARGET_STRIP) --strip-all python$(EXE)

install: build
	$(MAKE) install DESTDIR="$(DESTDIR)"

clean:
	find . -path './.nanvix' -prune -o -type d -name '__pycache__' \
		-exec rm -rf {} +
	find . -path './.nanvix' -prune -o -type f \
		\( -name '*.py[co]' -o -name '*.[oa]' -o -name '*.s[ol]' \
		-o -name '*.so.[0-9]*.[0-9]*' -o -name '*.lto' -o -name '*.wasm' \
		-o -name '*.lst' \) -exec rm -f {} +
	rm -rf build
	rm -f pybuilddir.txt _bootstrap_python Programs/_testembed Programs/_freeze_module
	rm -f Python/deepfreeze/*.[co] Python/frozen_modules/*.h
	rm -f Python/frozen_modules/MANIFEST Include/pydtrace_probes.h
	rm -f $(CONFIGURED_MARKER) python python$(EXE) libpython3.12.a

.PHONY: all configure build install clean
