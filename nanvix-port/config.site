# config.site — Pre-answered configure checks for NanVix cross-compilation.
# CPython's configure probes many features by compiling and running test programs.
# Cross-compilation can't run tests on the target, so we pre-answer them here.

# Basic types
ac_cv_sizeof_int=4
ac_cv_sizeof_long=4
ac_cv_sizeof_long_long=8
ac_cv_sizeof_void_p=4
ac_cv_sizeof_short=2
ac_cv_sizeof_float=4
ac_cv_sizeof_double=8
ac_cv_sizeof_fpos_t=8
ac_cv_sizeof_size_t=4
ac_cv_sizeof_ssize_t=4
ac_cv_sizeof_pid_t=4
ac_cv_sizeof_off_t=4
ac_cv_sizeof_time_t=8
ac_cv_sizeof_wchar_t=4
ac_cv_sizeof_uintptr_t=4
ac_cv_sizeof__Bool=1

# Byte order
ac_cv_c_bigendian=no

# Working functions (NanVix provides these via libposix)
ac_cv_func_clock_gettime=yes
ac_cv_func_clock_getres=yes
ac_cv_func_nanosleep=yes
ac_cv_func_gettimeofday=yes
ac_cv_func_select=yes
ac_cv_func_poll=yes
ac_cv_func_pipe=yes
ac_cv_func_dup=yes
ac_cv_func_dup2=yes
