# Threading (NanVix has full pthreads)
ac_cv_func_pthread_create=yes
ac_cv_func_pthread_join=yes
ac_cv_func_pthread_detach=yes
ac_cv_func_pthread_kill=yes
ac_cv_func_pthread_sigmask=yes
ac_cv_func_sem_init=yes
ac_cv_func_sem_post=yes
ac_cv_func_sem_wait=yes

# Socket functions (NanVix has full sockets)
ac_cv_func_socket=yes
ac_cv_func_socketpair=yes
ac_cv_func_bind=yes
ac_cv_func_listen=yes
ac_cv_func_accept=yes
ac_cv_func_connect=yes
ac_cv_func_send=yes
ac_cv_func_recv=yes
